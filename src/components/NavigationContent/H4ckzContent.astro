---
interface Props {
  mode: 'submenu' | 'page';
}

const { mode } = Astro.props;

const links = [
  { name: 'Latest Scam Alert', href: '/blog/sams-scams', description: 'Stay informed about recent security threats' },
  { name: 'Research Papers', href: '/research', description: 'Deep dives into cybersecurity' },
  { name: 'Security Tools', href: '/projects#security', description: 'Essential tools for protection' }
];
---

<div class={`h4ckz-content mode-${mode}`}>
  {mode === 'submenu' ? (
    <div class="submenu-grid">
      {links.map(link => (
        <a href={link.href} class="nav-link">
          <span class="link-text">{link.name}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="page-grid">
      <h2 class="section-title">2025 H4CKZ</h2>
      {links.map(link => (
        <a href={link.href} class="nav-link-expanded">
          <h3 class="link-title">{link.name}</h3>
          <p class="link-description">{link.description}</p>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .h4ckz-content {
    color: #fff;
  }

  .submenu-grid {
    display: grid;
    gap: 0.75rem;
  }

  .page-grid {
    display: grid;
    gap: 2rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: bold;
    color: rgb(52, 211, 153);
    margin-bottom: 1rem;
    text-shadow: 0 0 15px rgba(52, 211, 153, 0.5);
  }

  .nav-link {
    display: block;
    padding: 0.75rem 1rem;
    background: rgba(52, 211, 153, 0.1);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .nav-link:hover {
    background: rgba(52, 211, 153, 0.2);
    transform: translateX(10px);
  }

  .nav-link-expanded {
    display: block;
    padding: 1.5rem;
    background: rgba(52, 211, 153, 0.1);
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    border: 1px solid rgba(52, 211, 153, 0.2);
  }

  .nav-link-expanded:hover {
    background: rgba(52, 211, 153, 0.15);
    transform: translateY(-5px);
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .link-title {
    font-size: 1.25rem;
    font-weight: bold;
    color: rgb(52, 211, 153);
    margin-bottom: 0.5rem;
  }

  .link-description {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .page-grid {
      gap: 1rem;
    }

    .nav-link-expanded {
      padding: 1rem;
    }
  }
</style>
