---
interface Props {
  section: string;
  isActive: boolean;
  mode: 'submenu' | 'page';
}

const { section, isActive, mode } = Astro.props;

// Dynamic class generation based on section and mode
const containerClasses = [
  'nav-container',
  isActive ? 'active' : '',
  `nav-container-${section}`,
  `mode-${mode}`
].filter(Boolean).join(' ');
---

<div 
  class={containerClasses}
  data-section={section}
  data-mode={mode}
  role={mode === 'submenu' ? 'menu' : 'navigation'}
>
  <div class="nav-content">
    <slot />
  </div>
</div>

<style>
  .nav-container {
    --nav-y-position: var(--submenu-y, 50%);
    --nav-x-position: var(--submenu-x, 0);
    --nav-scale: var(--submenu-scale, 0.9);
    --nav-opacity: var(--submenu-opacity, 0);
    
    position: fixed;
    top: 50%;
    transform: translate(var(--nav-x-position), var(--nav-y-position)) scale(var(--nav-scale));
    opacity: var(--nav-opacity);
    z-index: 20;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    border-radius: 1rem;
    padding: 1.5rem;
    border: 1px solid rgba(52, 211, 153, 0.3);
    box-shadow: 0 0 20px rgba(52, 211, 153, 0.2);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    min-width: 250px;
  }

  .nav-container.active {
    --nav-opacity: 1;
    pointer-events: auto;
  }

  /* Section-specific positioning */
  .nav-container-h4ckz {
    --submenu-x: calc(-50% - 8rem);
  }

  .nav-container-projects {
    --submenu-x: calc(50% + 8rem);
  }

  .nav-container-about {
    --submenu-y: calc(-50% - 8rem);
    --submenu-x: -50%;
  }

  .nav-container-defi {
    --submenu-y: calc(50% + 8rem);
    --submenu-x: -50%;
  }

  /* Mode-specific styles */
  .mode-page {
    --nav-scale: 1;
    --nav-opacity: 1;
    width: 100%;
    max-width: 1200px;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.9);
    border-color: rgba(52, 211, 153, 0.5);
    box-shadow: 0 0 40px rgba(52, 211, 153, 0.3);
  }

  .nav-content {
    display: grid;
    gap: 1rem;
    opacity: var(--nav-opacity);
    transform: translateY(calc((1 - var(--nav-opacity)) * 10px));
    transition: all 0.3s ease-out;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .nav-container {
      width: 90%;
      margin: 0 auto;
      --submenu-x: -50% !important;
      left: 50%;
    }
  }
</style>
